{
  "uid": "meta-platform-health",
  "title": "Platform Health — LGTMP components",
  "tags": ["_meta", "platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingester replicas ready (Mimir)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir-meta" },
      "targets": [
        {
          "expr": "sum(up{job=~\".*mimir-ingester.*\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Loki write path replicas ready",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir-meta" },
      "targets": [
        {
          "expr": "sum(up{job=~\".*loki.*\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Object storage write errors (all pillars)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir-meta" },
      "targets": [
        { "expr": "sum by (job) (rate(thanos_objstore_bucket_operation_failures_total[5m]))", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingest samples/s per tenant (Mimir)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir-meta" },
      "targets": [
        {
          "expr": "sum by (user) (rate(cortex_distributor_received_samples_total[5m]))",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingest MB/s per tenant (Loki)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "mimir-meta" },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(loki_distributor_bytes_received_total[5m])) / 1024 / 1024",
          "legendFormat": "{{tenant}}"
        }
      ]
    }
  ]
}
